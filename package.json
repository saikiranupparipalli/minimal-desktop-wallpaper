{
  "name": "project-wallpaper",
  "private": true,
  "version": "0.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite --port 5199 --host 127.0.0.1\" \"npm run electron:dev\"",
    "build": "tsc -b && tsc -p tsconfig.electron.json && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "tsc -p tsconfig.electron.json && wait-on tcp:127.0.0.1:5199 && cross-env NODE_ENV=development electron ."
  },
  "dependencies": {
    "electron-is-dev": "^3.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-rnd": "^10.5.3",
    "sql.js": "^1.14.2",
    "wallpaper": "^7.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  }
}
